TRADING212_API_KEY=your-trading212-api-key
TRADING212_API_SECRET=your-trading212-api-secret
TRADING212_BASE_URL=https://live.trading212.com/api/v0
DATABASE_URL=postgresql+psycopg2://trader:your-local-password@localhost:5432/trader
DASHBOARD_API_KEY=choose-a-long-random-string
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_API_SECRET=your-alpaca-api-secret
FINNHUB_API_KEY=
# IEX is not a consolidated market feed. Set SIP only with the appropriate Alpaca subscription.
ALPACA_DATA_FEED=iex
ALPACA_WATCHLIST_LIMIT=50
SNAPSHOT_INTERVAL_MINUTES=15
HISTORY_SYNC_INTERVAL_MINUTES=60

# Watchlist catalyst briefing. OpenAI analysis stays off until explicitly enabled.
NEWS_ENABLED=true
OPENAI_API_KEY=
OPENAI_NEWS_ENABLED=false
# Opt in to billed per-stock web searches. Uses the OpenAI news token budget.
OPENAI_NEWS_WEB_SEARCH_ENABLED=false
OPENAI_NEWS_MODEL=gpt-5.4-mini
# This app's UTC-day cap (00:00 reset); keep room for other projects sharing the allowance.
OPENAI_NEWS_DAILY_TOKEN_BUDGET=2400000
# Identify your application and contact address when requesting SEC EDGAR data.
SEC_USER_AGENT=
# Optional free earnings-calendar key. Without it, configure company calendar feeds below.
ALPHA_VANTAGE_API_KEY=
# Optional RSS/Atom provider name -> feed URL (company IR, GlobeNewswire, etc.).
NEWS_IR_FEEDS_JSON={}
NEWS_RSS_FEEDS_JSON={}
# Optional ticker -> official company ICS calendar URL.
NEWS_IR_EVENT_FEEDS_JSON={}
# Explicit, verified ticker -> exposure tags. Supported: oil_producer, airline_fuel,
# semiconductor_exports, china_sales, semiconductor_supply_chain, ai_infrastructure,
# enterprise_software, data_center_power, optical_interconnect, ai_memory,
# data_center_storage. Indirect industry and geopolitical news needs these tags.
NEWS_EXPOSURES_JSON={}
